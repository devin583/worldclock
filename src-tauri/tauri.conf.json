{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorldClock",
  "version": "0.3.4",
  "identifier": "com.worldclock.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WorldClock",
        "width": 860,
        "height": 360,
        "minWidth": 480,
        "minHeight": 260,
        "maxWidth": 1200,
        "maxHeight": 680,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "skipTaskbar": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
